import torch.nn as nn

# Define a custom SE layer
class SE(nn.Module):
    def __init__(self, cin, ratio=16):
        super(SE, self).__init__()

        # Global Average Pooling (GAP) layer
        self.gap = nn.AdaptiveAvgPool2d(1)

        # Linear transformation + ReLU activation
        self.fc1 = nn.Linear(cin, int(cin / ratio), bias=False)
        self.relu = nn.ReLU()

        # Linear transformation + Sigmoid activation
        self.fc2 = nn.Linear(int(cin / ratio), cin, bias=False)
        self.sigmoid = nn.Sigmoid()

    def forward(self, x):
        # Perform GAP operation
        y = self.gap(x)

        # Flatten output
        y = y.view(y.shape[0], -1)

        # Apply linear transformations and activations
        y = self.fc1(y)
        y = self.relu(y)
        y = self.fc2(y)
        y = self.sigmoid(y)

        # Return result
        return x * y


# Create a simple CNN model
