class EVE(nn.Module):
    def __init__(self, cin, ksize, cout):
        super().__init__()
        self.maxpool = nn.MaxPool2d(2, ceil_mode=True)
        self.minpool = MinPool2d_x(ksize, stride=2, ceil_mode=True)
        self.pw = nn.Conv2d(cin, cout, ksize, padding=ksize//2, groups=2, bias=False)
