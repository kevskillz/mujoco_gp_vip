import torch.nn as nn

class GlobalAveragePooling2D(nn.Module):
    def __init__(self):
        super(GlobalAveragePooling2D, self).__init__()

    def forward(self, x):
        # Perform global average pooling over the last two dimensions
        return F.avg_pool2d(x, kernel_size=x.size()[2:], stride=1)

class LayerNormalization(nn.Module):
    def __init__(self, num_features, eps=1e-5):
        super(LayerNormalization, self).__init__()
        self.eps = eps
        self.gamma = nn.Parameter(torch.ones(num_features))
        self.beta = nn.Parameter(torch.zeros(num_features))

    def forward(self, x):
        mean = x.mean(dim=-1, keepdim=True)
        std = x.std(dim=-1, keepdim=True)
        return self.gamma * (x - mean) / (std + self.eps) + self.beta

class SigmoidActivation(nn.Module):
    def __init__(self):
        super(SigmoidActivation, self).__init__()

    def forward(self, x):
        return torch.sigmoid(x)

# Define the SE_LN class
class SE_LN(nn.Module):
    def __init__(self, cin):
        super(SE_LN, self).__init__()
        self.global_avg_pool = GlobalAveragePooling2D()
        self.layer_norm = LayerNormalization(cin)
        self.sigmoid = SigmoidActivation()

    def forward(self, x):
        # Apply global average pooling
        avg_pool = self.global_avg_pool(x)

        # Normalize the pooled features
        normed_features = self.layer_norm(avg_pool)

        # Apply sigmoid activation
        activated_features = self.sigmoid(normed_features)

        # Concatenate the normalized and activated features
        concat_features = torch.cat([x, activated_features], dim=1)

        return concat_features

