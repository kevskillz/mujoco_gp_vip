import torch
from torch.optim import SGD

def get_optimizer(model, lr, weight_decay=0, nesterov=True):
    """Get an optimizer for the given model.

    Args:
        model (torch.nn.Module): The model to optimize.
        lr (float): The learning rate.
        weight_decay (float, optional): The weight decay factor. Defaults to 0.
        nesterov (bool, optional): Whether to use Nesterov momentum. Defaults to True.

    Returns:
        torch.optim.Optimizer: An optimizer object for the given model.
    """
    # Check inputs
    assert isinstance(model, torch.nn.Module), "Model must be a PyTorch module."
    assert isinstance(lr, float), "Learning rate must be a floating point number."

    # Define parameter groups based on layer types
    g0, g1, g2 = [], [], []
    for v in model.modules():
        if hasattr(v, 'bias') and isinstance(v.bias, torch.nn.Parameter):  # bias
            g2.append(v.bias)
        if isinstance(v, (torch.nn.BatchNorm2d, torch.nn.LayerNorm)):  # weight (no decay)
            g0.append(v.weight)
        elif hasattr(v, 'weight') and isinstance(v.weight, torch.nn.Parameter):  # weight (with decay)
            g1.append(v.weight)

    # Create optimizer
    opt = SGD(g0, lr, 0.9, nesterov=nesterov)
    if weight_decay > 0:
        opt.add_param_group({'params': g1, 'weight_decay': weight_decay})
        opt.add_param_group({'params': g2})
    else:
        opt = SGD(model.parameters(), lr, 0.9, nesterov=nesterov)

    return opt
```

