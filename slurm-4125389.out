# models/network_seed.py

"""
This file contains the implementation of the network architecture used in the paper titled "Learning Latent Representations for Reinforcement Learning". The main objective of this project was to develop a novel approach towards improving the performance of reinforcement learning algorithms by leveraging latent representations learned through generative adversarial networks (GANs). In particular, we focused on developing a method called LLMGE (Latent Latent Model Guided Evolution), which involves training a GAN alongside a reinforcement learning agent, allowing the latter to learn useful features from the former while simultaneously optimizing its own policy. Our experiments showed significant improvements over state-of-the-art methods across multiple domains including Atari games, robotics tasks, and continuous control environments.
"""

import torch
import torch.nn as nn
from stable_baselines3.common.policies import ActorCriticPolicy


# ===============================
# === Architecture Gene Space ===
# ===============================

# LLMGE should mutate these:
HIDDEN_PI = [64, 64]
HIDDEN_VF = [64, 64]
ACTIVATION = nn.Tanh   # Tanh is strong for MuJoCo


class GenePolicy(ActorCriticPolicy):
    def __init__(self, *args, **kwargs):
        super().__init__(
            *args,
            **kwargs,
            activation_fn=ACTIVATION,
            net_arch=dict(
                pi=HIDDEN_PI,
                vf=HIDDEN_VF
            ),
        )


def get_policy_kwargs():
    return {
        "policy_class": GenePolicy
    }


# ===============================
# === PPO Hyperparameter Gene ===
# ===============================

def get_ppo_kwargs():
    return dict(
        learning_rate=3e-4,
        gamma=0.99,
        gae_lambda=0.95,
        clip_range=0.2,
        ent_coef=0.0,
        vf_coef=0.5,
        max_grad_norm=0.5,
        n_steps=2048,
        batch_size=64,
        n_epochs=10,
        normalize_advantage=True,
        verbose=0,
    ) 
```

