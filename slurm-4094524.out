import torch
from torch import nn


class MaxPool2d_y(nn.Module):
    def __init__(self, ks, ceil_mode):
        super().__init__()
        self.ks = ks
        self.ceil_mode = ceil_mode

    def forward(self, x):
        return -torch.max_pool2d(-x, self.ks, ceil_mode=self.ceil_mode)


class FCT(nn.Module):
    def __init__(self, cin, cout):
        super().__init__()
        self.dw = nn.Conv2d(cin, cin, 4, 2, 1, groups=cin, bias=False)
        self.maxpool = nn.MaxPool2d(2, ceil_mode=True)
        self.minpool = MaxPool2d_y(2, ceil_mode=True)
        self.pw = nn.Conv2d(3 * cin, cout, 1, 1, bias=False)
        self.bn = nn.BatchNorm2d(cout)

    def forward(self, x):
        x = torch.cat((self.maxpool(x), self.minpool(x), self.dw(x)), 1)
        x = self.pw(x)
        x = self.bn(x)
        return x

