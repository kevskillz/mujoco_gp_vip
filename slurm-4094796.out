for epoch in range(10):
    train_loss = 0
    for x, y in dataset:
        optimizer.zero_grad()
        output = model(x)
        loss = loss_fn(output, y)
        loss.backward()
        optimizer.step()
        train_loss += loss.item() / len(dataset)
    print(f"Epoch {epoch+1}: Train Loss={train_loss:.4f}")

