class MinPool2d_x(torch.nn.Module):
    def __init__(self, ks, ceil_mode):
        super(MinPool2d_x, self).__init__()
        self.ks = ks
        self.ceil_mode = ceil_mode

    def forward(self, x):
        return -torch.max_pool2d(-x, self.ks, ceil_mode=self.ceil_mode)


class EVE(torch.nn.Module):
    def __init__(self, cin, cout):
        super(EVE, self).__init__()
        self.maxpool = torch.nn.MaxPool2d(2, ceil_mode=True)
        self.minpool = MinPool2d_x(2, ceil_mode=True)
        self.pw = torch.nn.Conv2d(2 * cin, cout, 1, 1, bias=False)
        self.bn = torch.nn.BatchNorm2d(cout)

    def forward(self, x):
        x = torch.cat((self.maxpool(x), self.minpool(x)), 1)
        x = self.pw(x)
        x = self.bn(x)
        return x
