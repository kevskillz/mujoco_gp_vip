def get_optimizer(model, lr, weight_decay=None, momentum=None, nesterov=False):
    """Get optimizer based on given parameters."""
    
    # Check if all required arguments were passed
    assert weight_decay is not None or momentum is not None, "Weight decay and momentum must be specified."
    
