import torch.nn as nn
from torch.nn import Conv2d, MaxPool2d, AvgPool2d, ReLU, Dropout, Linear, BatchNorm2d


class FCT(nn.Module):
    def __init__(self, cin, cout):
        super(FCT, self).__init__()

        # Define convolutional blocks
        self.conv1 = Conv2d(cin, cin, kernel_size=(7, 7), stride=(2, 2))
        self.conv2 = Conv2d(cin, cin, kernel_size=(3, 3), padding=(1, 1))
        self.conv3 = Conv2d(cin, cin, kernel_size=(3, 3), padding=(1, 1))

        # Define max pooling layer
        self.pool = MaxPool2d(kernel_size=(2, 2), stride=(2, 2))

        # Define dropout layer
        self.dropout = Dropout(p=0.25)

        # Define fully connected layers
        self.fc1 = Linear(cin * 8, 512)
        self.fc2 = Linear(512, 256)
        self.fc3 = Linear(256, 10)

        # Initialize weights
        self._initialize_weights()

    def _initialize_weights(self):
        for m in self.modules():
            if isinstance(m, (Conv2d, BatchNorm2d)):
                nn.init.kaiming_normal_(m.weight, mode='fan_out', nonlinearity='relu')
                if hasattr(m, 'bias') and m.bias is not None:
                    nn.init.constant_(m.bias, 0)
            elif isinstance(m, Linear):
                nn.init.normal_(m.weight, mean=0, std=0.01)
                nn.init.constant_(m.bias, 0)

    def forward(self, x):
        out = self.conv1(x)
        out = self.relu(out)
        out = self.conv2(out)
        out = self.relu(out)
        out = self.conv3(out)
        out = self.relu(out)
        out = self.pool(out)
        out = self.dropout(out)
        out = out.view(-1, 64 * 32 * 32)
        out = self.fc1(out)
        out = self.relu(out)
        out = self.dropout(out)
        out = self.fc2(out)
        out = self.relu(out)
        out = self.dropout(out)
        out = self.fc3(out)
        return out
