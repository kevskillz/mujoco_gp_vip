```python
import torch
from torch import nn


class ME(nn.Module):
    def __init__(self, cin, cout):
        super().__init__()

        # Input shape: (batch_size, channels, height, width)
        # Output shape: (batch_size, channels, height // 2, width // 2)
        self.maxpool = nn.MaxPool2d(2, ceil_mode=True)

        # Input shape: (batch_size, channels, height // 2, width // 2)
        # Output shape: (batch_size, channels, height // 4, width // 4)
        self.pw = nn.Conv2d(cin, cout, 1, 1, bias=False)

        # Input shape: (batch_size, channels, height // 4, width // 4)
        # Output shape: (batch_size, channels, height // 8, width // 8)
        self.bn = nn.BatchNorm2d(cout)

    def forward(self, x):
        # Input shape: (batch_size, channels, height // 8, width // 8)
        # Output shape: (batch_size, channels, height // 16, width // 16)
        x = self.maxpool(x)

        # Input shape: (batch_size, channels, height // 16, width // 16)
        # Output shape: (batch_size, channels, height // 32, width // 32)
        x = self.pw(x)

