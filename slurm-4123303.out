import torch.nn as nn

class DFSEBV2(nn.Module):
    def __init__(self, cin, dw_s, is_LN=True):
        super().__init__()

        # Increase number of channels
        self.conv1 = nn.Sequential(
            nn.Conv2d(cin, cin*2, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1)),
            nn.BatchNorm2d(cin*2),
            nn.ReLU(inplace=True))
        
        # Add additional layers after projection head
        self.conv2 = nn.Sequential(
            nn.Conv2d(cin*2, cin*2, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1)),
            nn.BatchNorm2d(cin*2),
            nn.ReLU(inplace=True))

        # Add dropout layers
        self.dropout = nn.Dropout(p=0.25)

        # Define remaining components
        self.se = SE_LN(cin*2) if is_LN else SE(cin*2, 3)
        self.conv3 = nn.Conv2d(cin*2, cin, kernel_size=(1, 1), stride=(1, 1))
        self.conv4 = nn.Conv2d(cin, cin, kernel_size=(1, 1), stride=(1, 1))

    def forward(self, x):
        out = self.conv1(x)
        out = self.conv2(out)
        out = self.dropout(out)
        out = self.se(out)
        out = self.conv3(out)
        out = self.conv4(out)
        return out
```

