class EVE(nn.Module):
    def __init__(self, cin, cout):
        super().__init__()
        self.maxpool = nn.MaxPool2d(2, ceil_mode=True)
        self.combinedpoolinglayer = CombinedPoolingLayer()
        self.pw = nn.Conv2d(2*cin, cout, 1, 1, bias=False)
        self.bn = nn.BatchNorm2d(cout)

    def forward(self, x):
        x = torch.cat((self.maxpool(x), self.combinedpoolinglayer(x)), 1)
        x = self.pw(x)
        x = self.bn(x)
        return x
```

