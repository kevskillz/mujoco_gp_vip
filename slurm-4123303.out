class CombinedPoolingLayer(nn.Module):
    def __init__(self, kernel_size=2, stride=2, padding=0, dilation=1):
        super().__init__()
        self.kernel_size = kernel_size
        self.stride = stride
        self.padding = padding
        self.dilation = dilation
    
    def forward(self, x):
        # Perform max pooling
        max_pool = F.max_pool2d(x, self.kernel_size, self.stride, self.padding, self.dilation)
        
        # Perform min pooling
        min_pool = F.min_pool2d(x, self.kernel_size, self.stride, self.padding, self.dilation)
    
        # Combine the results
        combined = max_pool + min_pool
        
        return combined
```

